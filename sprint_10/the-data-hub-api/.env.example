# ========================================================
# Sprint 10 Track B: Environment Configuration Template
# COPY this file to .env and configure your MongoDB Atlas URI
# NEVER commit your actual .env with passwords to version control!
# ========================================================

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/the_data_hub_sprint10
MONGO_URI=mongodb+srv://developer:SecurePassword123@cluster0.mongodb.net/the_data_hub_sprint10?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=sprint10_enterprise_secure_token_secret_key_2026
